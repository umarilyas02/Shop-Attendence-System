{
  "name": "shop-attendance",
  "version": "1.0.0",
  "description": "Offline attendance system for retail shop (Windows 7 compatible)",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "cd node_modules/better-sqlite3 && node ../prebuild-install/bin.js --runtime=electron --target=22.3.27 --arch=x64",
    "postinstall": "npm run rebuild",
    "build:react": "webpack --config webpack.config.js",
    "watch:react": "webpack --config webpack.config.js --watch",
    "dist": "npm run build:react && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.shop.attendance",
    "productName": "Shop Attendance",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "!src/renderer/components/**/*.jsx",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false
    }
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "8.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.10.0",
    "electron": "22.3.27",
    "electron-builder": "^24.13.3",
    "style-loader": "^3.3.4",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  }
}
